# Supabase 설정
# Supabase 대시보드에서 Settings > API 에서 확인 가능
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# (서버 전용) Supabase service role 키
# ⚠️ 절대 클라이언트에 노출 금지 / Vercel에서는 Production 환경 변수로만 설정 권장
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 토스페이먼츠 설정
# 개발자센터 https://developers.tosspayments.com 에서 확인 가능
# (실결제 오픈 시) 운영 키 사용
# - client key: live_ck_...
# - secret key: live_sk_...
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_docs_Oyvez...
TOSS_SECRET_KEY=test_sk_docs_Oyvez...

# 이 파일을 .env.local로 복사하고 실제 값을 입력하세요
# cp env.example .env.local





