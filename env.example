# Supabase 설정
# Supabase 대시보드에서 Settings > API 에서 확인 가능
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 토스페이먼츠 설정
# 개발자센터 https://developers.tosspayments.com 에서 확인 가능
# 결제위젯 연동 키 사용 (클라이언트 키는 test_gck_..., 시크릿 키는 test_gsk_... 형태)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Oyvez...
TOSS_SECRET_KEY=test_gsk_docs_Oyvez...

# 이 파일을 .env.local로 복사하고 실제 값을 입력하세요
# cp env.example .env.local





